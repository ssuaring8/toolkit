{
  "manifest_version": 3,
  "name": "Gemini Copilot",
  "version": "0.2.1",
  "description": "Browse selected tabs, use your chosen Gemini account, and connect to an HTTP MCP server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Gemini Copilot"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
